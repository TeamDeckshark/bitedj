<!--
  One parameter row in the BeatFX column. Visibility binds to
  parameter{N}_loaded so the row collapses when an effect doesn't expose
  this slot.

  Only Beats-typed parameters (parameter{N}_units == 1) render by
  default; their bucket picker is the whole control surface. Continuous
  knobs ate too much vertical space at 800x480 and collided with deck
  select, so non-Beats slots collapse unless opted back in per slot via
  mixxx.cfg:

    [Skin]
    beatfx_show_param3 1

  (persisted CO, defaults to 0 — slot index N is positional within the
  loaded effect, not tied to a named parameter).

  Bucket mapping: labels read as period in beats (⅛, ¼, ½, 1, 2, 4),
  and the written value is rate in cycles per beat (1/period). Matches
  Tremolo's `rate` (the most-user-visible Beats parameter). For
  period-semantic parameters (Echo delay_time, Phaser lfo_period) the
  labels read inverted under this mapping — flag if those effects need
  per-parameter inverse pairings.

  Skin connections only bind one CO per visibility binding and have no
  AND/OR transform, so the composite visibility is built out of nested
  WidgetGroups.

  See CLAUDE.md "Mixxx fork patches" for the fork-side surface that
  exposes parameter{N}_units.
-->
<Template>
  <SetVariable name="EffectGroup">[EffectRack<Variable name="rack"/>_EffectUnit<Variable name="unit"/>_Effect<Variable name="effect"/>]</SetVariable>
  <WidgetGroup>
    <ObjectName>BeatFX_ParamRow</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>me,min</SizePolicy>
    <Children>

      <!--
        Branch A (Beats-typed parameters): label + bucket picker, two
        rows of three buttons. Always visible when loaded.
      -->
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>me,min</SizePolicy>
        <Children>

          <EffectParameterName>
            <ObjectName>BeatFX_ParamLabel</ObjectName>
            <Size>0me,0me</Size>
            <Alignment>left</Alignment>
            <Elide>right</Elide>
            <EffectRack><Variable name="rack"/></EffectRack>
            <EffectUnit><Variable name="unit"/></EffectUnit>
            <Effect><Variable name="effect"/></Effect>
            <EffectParameter><Variable name="param"/></EffectParameter>
          </EffectParameterName>

          <WidgetGroup>
            <ObjectName>BeatFX_BucketRow</ObjectName>
            <Layout>vertical</Layout>
            <SizePolicy>me,min</SizePolicy>
            <Children>
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Size>0me,36f</Size>
                <Children>
                  <Template src="skin:templates/effect_param_bucket.xml">
                    <SetVariable name="EffectGroup"><Variable name="EffectGroup"/></SetVariable>
                    <SetVariable name="param"><Variable name="param"/></SetVariable>
                    <SetVariable name="Label">⅛</SetVariable>
                    <SetVariable name="Value">8</SetVariable>
                  </Template>
                  <Template src="skin:templates/effect_param_bucket.xml">
                    <SetVariable name="EffectGroup"><Variable name="EffectGroup"/></SetVariable>
                    <SetVariable name="param"><Variable name="param"/></SetVariable>
                    <SetVariable name="Label">¼</SetVariable>
                    <SetVariable name="Value">4</SetVariable>
                  </Template>
                  <Template src="skin:templates/effect_param_bucket.xml">
                    <SetVariable name="EffectGroup"><Variable name="EffectGroup"/></SetVariable>
                    <SetVariable name="param"><Variable name="param"/></SetVariable>
                    <SetVariable name="Label">½</SetVariable>
                    <SetVariable name="Value">2</SetVariable>
                  </Template>
                </Children>
              </WidgetGroup>
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Size>0me,36f</Size>
                <Children>
                  <Template src="skin:templates/effect_param_bucket.xml">
                    <SetVariable name="EffectGroup"><Variable name="EffectGroup"/></SetVariable>
                    <SetVariable name="param"><Variable name="param"/></SetVariable>
                    <SetVariable name="Label">1</SetVariable>
                    <SetVariable name="Value">1</SetVariable>
                  </Template>
                  <Template src="skin:templates/effect_param_bucket.xml">
                    <SetVariable name="EffectGroup"><Variable name="EffectGroup"/></SetVariable>
                    <SetVariable name="param"><Variable name="param"/></SetVariable>
                    <SetVariable name="Label">2</SetVariable>
                    <SetVariable name="Value">0.5</SetVariable>
                  </Template>
                  <Template src="skin:templates/effect_param_bucket.xml">
                    <SetVariable name="EffectGroup"><Variable name="EffectGroup"/></SetVariable>
                    <SetVariable name="param"><Variable name="param"/></SetVariable>
                    <SetVariable name="Label">4</SetVariable>
                    <SetVariable name="Value">0.25</SetVariable>
                  </Template>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetGroup>

        </Children>
        <Connection>
          <ConfigKey><Variable name="EffectGroup"/>,parameter<Variable name="param"/>_units</ConfigKey>
          <BindProperty>visible</BindProperty>
          <Transform>
            <IsEqual>1</IsEqual>
          </Transform>
        </Connection>
      </WidgetGroup>

      <!--
        Branch B (non-Beats parameters): label + continuous knob.
        Hidden unless [Skin],beatfx_show_param{N} is set in mixxx.cfg.
      -->
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>me,min</SizePolicy>
        <Children>
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <SizePolicy>me,min</SizePolicy>
            <Children>

              <EffectParameterName>
                <ObjectName>BeatFX_ParamLabel</ObjectName>
                <Size>0me,0me</Size>
                <Alignment>left</Alignment>
                <Elide>right</Elide>
                <EffectRack><Variable name="rack"/></EffectRack>
                <EffectUnit><Variable name="unit"/></EffectUnit>
                <Effect><Variable name="effect"/></Effect>
                <EffectParameter><Variable name="param"/></EffectParameter>
              </EffectParameterName>

              <EffectParameterKnobComposed>
                <ObjectName>BeatFX_ParamKnob</ObjectName>
                <Size>40f,40f</Size>
                <Knob scalemode="STRETCH_ASPECT">icons/knob.svg</Knob>
                <MinAngle>-230</MinAngle>
                <MaxAngle>50</MaxAngle>
                <EffectRack><Variable name="rack"/></EffectRack>
                <EffectUnit><Variable name="unit"/></EffectUnit>
                <Effect><Variable name="effect"/></Effect>
                <EffectParameter><Variable name="param"/></EffectParameter>
                <Connection>
                  <ConfigKey><Variable name="EffectGroup"/>,parameter<Variable name="param"/></ConfigKey>
                </Connection>
              </EffectParameterKnobComposed>

            </Children>
            <Connection>
              <ConfigKey><Variable name="EffectGroup"/>,parameter<Variable name="param"/>_units</ConfigKey>
              <BindProperty>visible</BindProperty>
              <Transform>
                <IsEqual>1</IsEqual>
                <Not/>
              </Transform>
            </Connection>
          </WidgetGroup>
        </Children>
        <Connection>
          <ConfigKey persist="true">[Skin],beatfx_show_param<Variable name="param"/></ConfigKey>
          <BindProperty>visible</BindProperty>
        </Connection>
      </WidgetGroup>

    </Children>

    <Connection>
      <ConfigKey><Variable name="EffectGroup"/>,parameter<Variable name="param"/>_loaded</ConfigKey>
      <BindProperty>visible</BindProperty>
    </Connection>
  </WidgetGroup>
</Template>
