<Template>
  <WidgetGroup>
    <ObjectName>LibraryColumnRow</ObjectName>
    <Layout>horizontal</Layout>
    <Size>0me,48f</Size>
    <Children>
      <Label>
        <ObjectName>LibraryColumnRowLabel</ObjectName>
        <Text><Variable name="Label"/></Text>
        <Size>0me,0me</Size>
      </Label>
      <PushButton>
        <ObjectName>LibraryColumnVisibleButton</ObjectName>
        <Size>56f,40f</Size>
        <NumberStates>2</NumberStates>
        <State>
          <Number>0</Number>
          <Text>OFF</Text>
        </State>
        <State>
          <Number>1</Number>
          <Text>ON</Text>
        </State>
        <Connection>
          <ConfigKey><Variable name="VisibleConfigKey"/></ConfigKey>
          <EmitOnDownPress>true</EmitOnDownPress>
          <ButtonState>LeftButton</ButtonState>
        </Connection>
      </PushButton>
      <WidgetGroup>
        <ObjectName>LibraryColumnSegmented</ObjectName>
        <Layout>horizontal</Layout>
        <Size>160f,40f</Size>
        <Children>
          <Template src="skin:templates/setting_segment_button.xml">
            <SetVariable name="ObjectName">SettingsSegmentLeft</SetVariable>
            <SetVariable name="Text">XS</SetVariable>
            <SetVariable name="ConfigKey"><Variable name="WeightConfigKey"/></SetVariable>
            <SetVariable name="Value">1</SetVariable>
          </Template>
          <Template src="skin:templates/setting_segment_button.xml">
            <SetVariable name="ObjectName">SettingsSegmentMid</SetVariable>
            <SetVariable name="Text">S</SetVariable>
            <SetVariable name="ConfigKey"><Variable name="WeightConfigKey"/></SetVariable>
            <SetVariable name="Value">2</SetVariable>
          </Template>
          <Template src="skin:templates/setting_segment_button.xml">
            <SetVariable name="ObjectName">SettingsSegmentMid</SetVariable>
            <SetVariable name="Text">M</SetVariable>
            <SetVariable name="ConfigKey"><Variable name="WeightConfigKey"/></SetVariable>
            <SetVariable name="Value">3</SetVariable>
          </Template>
          <Template src="skin:templates/setting_segment_button.xml">
            <SetVariable name="ObjectName">SettingsSegmentRight</SetVariable>
            <SetVariable name="Text">L</SetVariable>
            <SetVariable name="ConfigKey"><Variable name="WeightConfigKey"/></SetVariable>
            <SetVariable name="Value">4</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
