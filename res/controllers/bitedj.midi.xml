<?xml version="1.0" encoding="utf-8"?>
<MixxxControllerPreset mixxxVersion="2.3.0+" schemaVersion="1">
  <info>
    <name>DeckShark Eject</name>
    <author>deckshark</author>
    <description>Receives drive-eject notes from the DeckShark daemon; Mixxx unloads every track on the drive and unmounts it ([BiteDJ],eject_driveN).</description>
    <hidden>true</hidden>
  </info>
  <controller id="DeckShark:eject">
    <scriptfiles/>
    <controls>
      <control>
        <group>[BiteDJ]</group>
        <key>eject_drive1</key>
        <status>0x90</status>
        <midino>0x40</midino>
        <options><Normal/></options>
      </control>
      <control>
        <group>[BiteDJ]</group>
        <key>eject_drive2</key>
        <status>0x90</status>
        <midino>0x41</midino>
        <options><Normal/></options>
      </control>
      <control>
        <group>[BiteDJ]</group>
        <key>eject_drive3</key>
        <status>0x90</status>
        <midino>0x42</midino>
        <options><Normal/></options>
      </control>
      <control>
        <group>[BiteDJ]</group>
        <key>eject_drive4</key>
        <status>0x90</status>
        <midino>0x43</midino>
        <options><Normal/></options>
      </control>
    </controls>
    <outputs/>
  </controller>
</MixxxControllerPreset>
